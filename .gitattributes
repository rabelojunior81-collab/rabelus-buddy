# Texto sempre com LF no repositório, em qualquer sistema operacional.
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary

# Proveniência: bytes exatamente como importados (inclusive CRLF). Nunca normalizar.
docs/00-proveniencia/** -text

# Arquivos append-only do buddy-dev: ramos paralelos somam linhas no merge, sem conflito.
.buddy-dev/CHANGELOG.md merge=union
.buddy-dev/LEARNING-CURVE.md merge=union
.buddy-dev/diario/*.md merge=union
